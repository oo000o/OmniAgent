{
  "agents": {
    "defaults": {
      "unifiedSession": true,
      "timezone": "Asia/Shanghai",
      "maxToolIterations": 40
    }
  },
  "channels": {
    "feishu": {
      "enabled": true,
      "appId": "${FEISHU_APP_ID}",
      "appSecret": "${FEISHU_APP_SECRET}",
      "domain": "feishu",
      "groupPolicy": "mention",
      "topicIsolation": true,
      "allowFrom": ["${FEISHU_OPEN_ID}"]
    },
    "sendMaxRetries": 3
  },
  "tools": {
    "restrictToWorkspace": true,
    "career": {
      "enable": true,
      "databasePath": ".nanobot/career.db",
      "taskDatabasePath": ".nanobot/tasks.db"
    },
    "knowledge": {
      "enable": true,
      "databasePath": ".nanobot/knowledge.db",
      "defaultResults": 5,
      "retrievalMode": "vector",
      "candidateResults": 20,
      "embeddingModel": "Qwen/Qwen3-Embedding-0.6B",
      "embeddingApiKey": "${MODELSCOPE_API_KEY}",
      "embeddingBaseUrl": "https://api-inference.modelscope.cn/v1",
      "embeddingBatchSize": 32,
      "fallbackToLexical": true,
      "queryRewrite": {
        "enabled": false,
        "maxRewrittenQueries": 3,
        "model": "Qwen/Qwen3.5-35B-A3B",
        "apiKey": "${MODELSCOPE_API_KEY}",
        "baseUrl": "https://api-inference.modelscope.cn/v1",
        "timeoutS": 30
      },
      "rerank": {
        "enabled": false,
        "candidateK": 15,
        "model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
        "preferNeural": true
      }
    },
    "mcpServers": {
      "omniagent_tasks": {
        "type": "stdio",
        "command": "python",
        "args": ["-m", "nanobot.tasking.mcp_server"],
        "cwd": "<PROJECT_ROOT>/source",
        "env": {
          "OMNIAGENT_TASK_DB": "<PROJECT_ROOT>/source/workspace/.nanobot/tasks.db"
        },
        "enabledTools": [
          "task_create",
          "task_get",
          "task_list",
          "task_update",
          "task_cancel"
        ]
      }
    }
  }
}
